    "test": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@bigmoves/lexicon": "^0.2.4",
    "@duckdb/node-api": "^1.4.4-r.1",
    "@hatk/oauth-client": "*",
    "@noble/curves": "^2.4.0",
    "@resvg/resvg-js": "^2.6.2",
    "better-sqlite3": "^12.6.2",
    "satori": "^0.28.1",
    "vitest": "^4",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^19.2.14",
    "@vitest/coverage-v8": "^4.1.11",
    "sharp": "^0.35.4",
    "vite": "^8.0.0"
  },
  "peerDependencies": {
    "sharp": "^0.35.4",
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    }
  }
