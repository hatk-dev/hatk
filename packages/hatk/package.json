{
  "name": "@hatk/hatk",
  "version": "0.0.1-alpha.99",
  "license": "MIT",
  "bin": {
    "hatk": "dist/cli.js"
  },
  "files": [
    "dist",
    "fonts",
    "public"
  ],
  "type": "module",
  "exports": {
    "./feeds": "./dist/feeds.js",
    "./xrpc": "./dist/xrpc.js",
    "./opengraph": "./dist/opengraph.js",
    "./labels": "./dist/labels.js",
    "./lex-types": "./dist/lex-types.js",
    "./xrpc-client": "./dist/xrpc-client.js",
    "./views": "./dist/views.js",
    "./seed": "./dist/seed.js",
    "./hooks": "./dist/hooks.js",
    "./setup": "./dist/setup.js",
    "./test": "./dist/test.js",
    "./config": "./dist/config.js",
    "./vite-plugin": "./dist/vite-plugin.js",
    "./renderer": "./dist/renderer.js",
    "./spaces": "./dist/spaces/index.js"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.build.json && cp -r src/templates dist/templates && cp -r src/lexicons dist/lexicons",
